{
  "name": "choreo-cue",
  "main": "src/index.tsx",
  "scripts": {
    "start": "NODE_ENV=development expo start",
    "build:ios": "NODE_ENV=production eas build --platform ios",
    "build:ios:local": "NODE_ENV=production eas build --platform ios --local",
    "build:android": "NODE_ENV=production eas build --platform android",
    "test": "jest --watch --coverage=false",
    "eject": "expo eject",
    "prepare": "husky",
    "postinstall": "patch-package && rm -rf node_modules/react-native-spotify-remote/ios/external/SpotifySDK/SpotifyiOS.framework && bash scripts/strip-spotify-bitcode.sh",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@10play/tentap-editor": "1.0.1",
    "@expo/knex-expo-sqlite-dialect": "0.1.0",
    "@expo/vector-icons": "15.1.1",
    "@react-native-assets/slider": "11.0.12",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "@tanstack/react-query": "^5.51.21",
    "@types/react": "~19.2.10",
    "axios": "^1.7.3",
    "babel-plugin-module-resolver": "5.0.3",
    "dripsy": "^4.3.7",
    "expo": "^57.0.0",
    "expo-application": "~57.0.0",
    "expo-asset": "~57.0.0",
    "expo-audio": "57.0.4",
    "expo-auth-session": "~57.0.0",
    "expo-build-properties": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.0",
    "format-duration": "^3.0.2",
    "fs": "^0.0.1-security",
    "knex": "3.2.10",
    "lodash": "^4.17.21",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-awesome-slider": "^2.9.0",
    "react-native-dotenv": "3.4.11",
    "react-native-elements": "^3.4.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-loading-spinner-overlay": "^3.0.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-spotify-remote": "1.0.0-1",
    "react-native-text-ticker": "^1.14.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "rollbar": "2.26.5",
    "rollbar-react-native": "1.0.1",
    "typescript": "~6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@faker-js/faker": "9.9.0",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.24",
    "@types/mock-knex": "0.4.8",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eas-cli": "20.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "lint-staged": "^17.0.0",
    "mock-knex": "0.4.13",
    "patch-package": "8.0.1",
    "postinstall-postinstall": "2.1.0",
    "prettier": "3.8.3",
    "react-native-svg": "15.15.3",
    "react-native-svg-transformer": "^1.5.0",
    "sqlite3": "6.0.1",
    "ts-jest": "^29.2.5"
  },
  "private": true,
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "version": "0.0.0-development",
  "repository": {
    "type": "git",
    "url": "git@github.com:pnarielwala/choreo-cue.git"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  }
}
